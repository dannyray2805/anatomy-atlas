# Production build config for the Pages app — COMMITTED ON PURPOSE.
#
# Vite loads `.env.production` automatically for `vite build` (mode=production), which is what
# CI runs. Without this file the GitHub Actions gate builds an env-less bundle: `.env` is
# gitignored, so every `import.meta.env.VITE_*` was undefined and production rendered
# "DATA_MISSING" for the HOA volume plus empty /body and /reference canvases (found 2026-09-12).
#
# SECURITY: there are NO secrets here. Every value is a public URL that already ships inside the
# frontend bundle. `DEEPSEEK_API_KEY` stays a Cloudflare Worker secret and must never appear here
# (see AGENTS.md — "No API keys in Pages").
#
# Keep in sync with `packages/app/.env` (local dev) and `.env.example` (documented key list).
# Vite precedence for a production build: `.env.production.local` > `.env.local` > `.env.production`
# > `.env` — so a local override file still wins for local builds without touching this one.

# --- HuBMAP HRA ref-organ heart GLBs (CC BY 4.0), male + female v1.3 (sex toggle on /body) ---
VITE_HEART_GLB_MALE=https://cdn.humanatlas.io/digital-objects/ref-organ/heart-male/v1.3/assets/3d-vh-m-heart.glb
VITE_HEART_GLB_FEMALE=https://cdn.humanatlas.io/digital-objects/ref-organ/heart-female/v1.3/assets/3d-vh-f-heart.glb

# --- Z-Anatomy body layers (Reference Atlas route). Served same-origin: Pages /api/* proxy -> Worker -> R2.
# Per-bone/per-muscle TA -> Uberon mapping is NOT done, so those clicks stay "not in this dataset".
# CC BY-SA 4.0 / CC BY-SA 2.1 Japan; old label-carrying keys remain on R2 as rollback. ---
VITE_SKELETON_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/skeleton-v2-draco.glb
VITE_MUSCLE_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/muscle-v3-draco.glb
VITE_Z_ANATOMY_SKIN_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/skin-v2-draco.glb

# --- HuBMAP VH per-sex whole-body skins (CC BY 4.0). Same individual frame as that sex's
# heart/vessels, so the peel renders at identity (no cross-individual registration). ---
VITE_SKIN_GLB_MALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/skin-v1-draco.glb
VITE_SKIN_GLB_FEMALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/skin-female-v1-draco.glb

# --- HuBMAP VH per-sex blood vasculature (CC BY 4.0). Whole-layer route: central/trunk
# arterial-venous tree only — NOT limb-to-fingertip peripheral. Only the ascending aorta has a
# published per-vessel structure row today. ---
VITE_VESSEL_GLB_MALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/vasculature-v1-draco.glb
VITE_VESSEL_GLB_FEMALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/vasculature-female-v1-draco.glb

# --- HOA HiP-CT heart, donor S-20-29 (portal dataset card 1773963465, 19.89 um complete organ).
# The ZARR value is HOA's own official "Visualize in Neuroglancer" link for that dataset.
# MUST stay double-quoted: dotenv treats an unquoted `#` as the start of a comment and would
# silently truncate this URL at the first `#`. ---
VITE_HOA_HEART_DOI=10.15151/ESRF-DC-1773964017
VITE_HOA_HEART_VOXEL_UM=19.89
VITE_HOA_HEART_LICENSE=CC-BY-4.0
VITE_HOA_HEART_PORTAL=https://human-organ-atlas.esrf.fr/explore/organ/heart
VITE_HOA_HEART_ZARR="https://neuroglancer-demo.appspot.com/#!%7B%22dimensions%22%3A%7B%22x%22%3A%5B0.00001989%2C%22m%22%5D%2C%22y%22%3A%5B0.00001989%2C%22m%22%5D%2C%22z%22%3A%5B0.00001989%2C%22m%22%5D%7D%2C%22layout%22%3A%224panel%22%2C%22projectionOrientation%22%3A%5B0.30000001192092896%2C0.20000000298023224%2C0%2C-0.8999999761581421%5D%2C%22projectionScale%22%3A4096%2C%22selectedLayer%22%3A%7B%22layer%22%3A%22S-20-29_heart_complete-organ_19.89um_bm18%22%2C%22visible%22%3Atrue%7D%2C%22position%22%3A%5B3819.5%2C3819.5%2C3885.5%5D%2C%22crossSectionScale%22%3A10%2C%22showSlices%22%3Afalse%2C%22layers%22%3A%5B%7B%22type%22%3A%22image%22%2C%22shaderControls%22%3A%7B%22normalized%22%3A%7B%22range%22%3A%5B18936%2C24935%5D%7D%7D%2C%22source%22%3A%5B%7B%22url%22%3A%22n5%3A%2F%2Fgs%3A%2F%2Fucl-hip-ct-35a68e99feaae8932b1d44da0358940b%2FS-20-29%2Fheart%2F19.89um_complete-organ_bm18%2F%22%7D%5D%2C%22opacity%22%3A1%2C%22volumeRendering%22%3A%22max%22%2C%22volumeRenderingDepthSamples%22%3A256%2C%22name%22%3A%22S-20-29_heart_complete-organ_19.89um_bm18%22%7D%5D%7D"

# --- Worker origin (public config only). Media is normally pulled same-origin through the Pages
# /api/* proxy; this is kept for direct Worker references. ---
VITE_WORKER_URL=https://anatomy-api.dannyray280579.workers.dev

# --- Cinematic hero. This is a CONTROL adult heart (Brunet et al., Radiology 2024, Movie 1) and
# is explicitly NOT donor S-20-29 — the caption states that on the page. Served same-origin via
# the Pages proxy. WebM first, H.264 MP4 fallback for browsers without VP9. ---
VITE_HOA_HERO=https://anatomy-atlas-5ca.pages.dev/api/media/hoa/hero/control-heart-cinematic.webm
VITE_HOA_HERO_POSTER=https://anatomy-atlas-5ca.pages.dev/api/media/hoa/hero/control-heart-cinematic-poster.webp
VITE_HOA_HERO_MP4=https://anatomy-atlas-5ca.pages.dev/api/media/hoa/hero/control-heart-cinematic.mp4

# --- Visible Human slice images. Empty => the app's default `/vh-fixtures` (committed fixtures
# under packages/app/public), which is not real NLM data and says so in the UI. ---
VITE_VH_SLICE_BASE=
