# Copy to `.env` (gitignored) and fill in real values before `pnpm dev`.
# All values here are public config — there are NO secrets in the frontend.
# Every key below is read via `import.meta.env` (typed in src/vite-env.d.ts).

# --- HuBMAP HRA ref-organ heart GLBs (CC BY 4.0), male + female v1.3 ---
VITE_HEART_GLB_MALE=https://cdn.humanatlas.io/digital-objects/ref-organ/heart-male/v1.3/assets/3d-vh-m-heart.glb
VITE_HEART_GLB_FEMALE=https://cdn.humanatlas.io/digital-objects/ref-organ/heart-female/v1.3/assets/3d-vh-f-heart.glb

# --- Z-Anatomy body layers (Reference Atlas route), served same-origin via the /api/* proxy -> Worker -> R2 ---
VITE_SKELETON_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/skeleton-v2-draco.glb
VITE_MUSCLE_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/muscle-v3-draco.glb
VITE_Z_ANATOMY_SKIN_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/skin-v2-draco.glb

# Z-Anatomy whole-body systems (same body). Start hidden, mount on demand (~10 MB with all five).
VITE_VISCERAL_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/visceral-v1-draco.glb
VITE_CARDIOVASCULAR_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/cardiovascular-v1-draco.glb
VITE_NERVOUS_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/nervous-v1-draco.glb
VITE_JOINTS_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/joints-v1-draco.glb
VITE_LYMPHOID_GLB=https://anatomy-atlas-5ca.pages.dev/api/media/z-anatomy/glb/lymphoid-v1-draco.glb

# --- HuBMAP VH whole-body skins (per-sex VH body peel on /body), same-origin via the /api/* proxy -> Worker -> R2 ---
VITE_SKIN_GLB_MALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/skin-v1-draco.glb
VITE_SKIN_GLB_FEMALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/skin-female-v1-draco.glb

# --- HuBMAP VH blood-vasculature (Vessels pill on /body), same-origin via the /api/* proxy -> Worker -> R2 ---
VITE_VESSEL_GLB_MALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/vasculature-v1-draco.glb
VITE_VESSEL_GLB_FEMALE=https://anatomy-atlas-5ca.pages.dev/api/media/hubmap/glb/vasculature-female-v1-draco.glb

# --- HOA HiP-CT heart, donor S-20-29 (values from the portal dataset card 1773963465) ---
# NOTE: the ZARR value is HOA's official "Visualize in Neuroglancer" URL for dataset 1773963465.
# Any URL containing a `#` fragment MUST be double-quoted in .env (dotenv treats `#` as a comment).
VITE_HOA_HEART_DOI=10.15151/ESRF-DC-1773964017
VITE_HOA_HEART_VOXEL_UM=19.89
VITE_HOA_HEART_LICENSE=CC-BY-4.0
VITE_HOA_HEART_PORTAL=https://human-organ-atlas.esrf.fr/explore/organ/heart
VITE_HOA_HEART_ZARR=""

# --- Worker origin (public). Serves /api/media/* from R2. ---
VITE_WORKER_URL=https://anatomy-api.dannyray280579.workers.dev

# --- Official cinematic hero (CONTROL heart, Radiology 2024 Movie 1 — NOT donor S-20-29) ---
# Empty VITE_HOA_HERO hides the hero (explorer-first). Media served same-origin via the /api/* proxy.
VITE_HOA_HERO=
VITE_HOA_HERO_POSTER=
# H.264 fallback (guaranteed decode on browsers without VP9; the WebM above is tried first).
VITE_HOA_HERO_MP4=

# --- Visible Human slice base. Empty => local /vh-fixtures fixtures. ---
VITE_VH_SLICE_BASE=
